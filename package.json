{
  "name": "strataboard",
  "version": "0.5.0",
  "description": "Insert financial data cards into Obsidian Canvas",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/copy-assets.mjs && node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node scripts/copy-assets.mjs && node scripts/build-cli.mjs && node scripts/build-mcp.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "build:mcp": "node scripts/build-mcp.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "release": "npm run build && node scripts/release.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "finance",
    "tushare",
    "canvas"
  ],
  "author": "izzy",
  "license": "MIT",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/sql.js": "^1.4.11",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.13.0",
    "tslib": "^2.6.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "js-yaml": "^4.1.0",
    "lightweight-charts": "^5.0.8",
    "papaparse": "^5.7.0",
    "sql.js": "^1.14.1",
    "zod": "^4.6.5"
  }
}
